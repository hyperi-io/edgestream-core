{% set adv = advanced | default({}) %}

{# --- pull values safely --- #}
{% set listen_port = adv.get('ssh.listen_port', '') | string | trim %}
{% set pwd_auth_raw = adv.get('ssh.password_authentication', true) %}
{% set ga_raw       = adv.get('ssh.google_auth', false) %}

{# normalize truthy/falsey: accept 1/0, true/false, yes/no, on/off, strings #}
{% set pwd_auth   = (pwd_auth_raw | string | lower in ['1', 'true', 'yes', 'on']) or (pwd_auth_raw | bool) %}
{% set google_2fa = (ga_raw | string | lower in ['1', 'true', 'yes', 'on']) or (ga_raw | bool) %}

{# Port: only emit if provided #}
{% if listen_port %}
Port {{ listen_port }}
{% endif %}

{% if pwd_auth %}
PasswordAuthentication yes
{% else %}
PasswordAuthentication no
{% endif %}

# Required for Google Authenticator
{% if google_2fa %}
KbdInteractiveAuthentication yes
AuthenticationMethods publickey,keyboard-interactive
{% else %}
KbdInteractiveAuthentication no
{% endif %}
