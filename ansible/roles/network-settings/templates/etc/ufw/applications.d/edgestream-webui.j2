{% set adv = advanced | default([]) %}

{# pull value and default_value, trimming whitespace #}
{% set lp_value = (
  adv | selectattr('label','equalto','webui.listen_port')
      | map(attribute='value') | first | d('') | string | trim
) %}
{% set lp_default = (
  adv | selectattr('label','equalto','webui.listen_port')
      | map(attribute='default_value') | first | d('443') | string | trim
) %}

{# choose value if non-empty, else default_value, else hard fallback #}
{% set listen_port = (lp_value if lp_value|length > 0 else (lp_default if lp_default|length > 0 else '443')) %}

[edgestream-webui]
title=EdgeStream Gateway webui
description=EdgeStream Gateway webui dashboard
ports={{ listen_port }}/tcp
