#jinja2: trim_blocks: True, lstrip_blocks: False
{# ---------- helpers ---------- #}
{% set S = source.settings | default({}, true) %}
{% import 'common/macros.j2' as H with context %}

# Postgresql Metrics
type: postgresql_metrics

{# endpoints is required by the component #}
{% set eps = S.get('endpoints') %}
{% if eps is not none and ((eps is string and eps|trim|length > 0) or (eps is sequence and not (eps is string) and eps|length > 0)) %}
endpoints:
{{ H.render_list(eps, '  ') }}
{% else %}
endpoints: []
{% endif %}

{% set exdb = S.get('exclude_databases') %}
{% if exdb is not none and ((exdb is string and exdb|trim|length > 0) or (exdb is sequence and not (exdb is string) and exdb|length > 0)) %}
exclude_databases:
{{ H.render_list(exdb, '  ') }}
{% endif %}

{% set indb = S.get('include_databases') %}
{% if indb is not none and ((indb is string and indb|trim|length > 0) or (indb is sequence and not (indb is string) and indb|length > 0)) %}
include_databases:
{{ H.render_list(indb, '  ') }}
{% endif %}

namespace: "{{ H.get('namespace', 'postgresql') }}"
scrape_interval_secs: {{ H.getint('scrape_interval_secs', 15) }}

{# TLS: only ca_file is supported here #}
{% set _caf = S.get('tls.ca_file') %}
{% if _caf is not none and (_caf|string)|trim|length > 0 %}
tls:
  ca_file: {{ certificatePath }}/ca/{{ _caf }}
{% endif %}
