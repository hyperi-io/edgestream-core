#jinja2: trim_blocks: True, lstrip_blocks: False
{# ---------- helpers ---------- #}
{% set S = source.settings | default({}, true) %}
{% import 'common/macros.j2' as H with context %}

# Host Metrics
type: host_metrics

{# ---------------- cgroups ---------------- #}
{% set _cg_base = S.get('cgroups.base') %}
{% set _cg_ex = S.get('cgroups.groups.excludes') %}
{% set _cg_in = S.get('cgroups.groups.includes') %}
{% if (_cg_base is not none and (_cg_base|string)|trim|length > 0)
   or (_cg_ex is sequence and _cg_ex|length > 0) or (_cg_ex is string and _cg_ex|trim|length > 0)
   or (_cg_in is sequence and _cg_in|length > 0) or (_cg_in is string and _cg_in|trim|length > 0) %}
cgroups:
{% if _cg_base is not none and (_cg_base|string)|trim|length > 0 %}
  base: {{ H.get('cgroups.base','') }}
{% endif %}
{% if (_cg_ex is not none and ((_cg_ex is sequence and _cg_ex|length>0) or (_cg_ex is string and _cg_ex|trim|length>0)))
   or (_cg_in is not none and ((_cg_in is sequence and _cg_in|length>0) or (_cg_in is string and _cg_in|trim|length>0))) %}
  groups:
{% if _cg_ex is not none and ((_cg_ex is sequence and _cg_ex|length>0) or (_cg_ex is string and _cg_ex|trim|length>0)) %}
    excludes:
{{ H.render_list(_cg_ex, '      ') }}
{% endif %}
{% if _cg_in is not none and ((_cg_in is sequence and _cg_in|length>0) or (_cg_in is string and _cg_in|trim|length>0)) %}
    includes:
{{ H.render_list(_cg_in, '      ') }}
{% endif %}
{% endif %}
{% endif %}

{# ---------------- collectors ---------------- #}
{% set _raw_collectors = S.get('collectors') %}
{% if _raw_collectors is not none %}
{% if _raw_collectors is string %}
  {# Support original JSON input or CSV fallback #}
  {% if '[' in _raw_collectors %}
    {% set collectors_list = _raw_collectors | from_json %}
  {% else %}
    {% set collectors_list = _raw_collectors.split(',') | map('trim') | select('string') | list %}
  {% endif %}
{% else %}
  {% set collectors_list = _raw_collectors %}
{% endif %}

{% if collectors_list and (collectors_list | length) > 0 %}
collectors:
{% for item in collectors_list %}
  - {{ item }}
{% endfor %}
{% endif %}
{% endif %}

{# ---------------- disk ---------------- #}
{% set _dk_ex = S.get('disk.devices.excludes') %}
{% set _dk_in = S.get('disk.devices.includes') %}
{% if (_dk_ex is not none and ((_dk_ex is sequence and _dk_ex|length>0) or (_dk_ex is string and _dk_ex|trim|length>0)))
   or (_dk_in is not none and ((_dk_in is sequence and _dk_in|length>0) or (_dk_in is string and _dk_in|trim|length>0))) %}
disk:
  devices:
{% if _dk_ex is not none and ((_dk_ex is sequence and _dk_ex|length>0) or (_dk_ex is string and _dk_ex|trim|length>0)) %}
    excludes:
{{ H.render_list(_dk_ex, '      ') }}
{% endif %}
{% if _dk_in is not none and ((_dk_in is sequence and _dk_in|length>0) or (_dk_in is string and _dk_in|trim|length>0)) %}
    includes:
{{ H.render_list(_dk_in, '      ') }}
{% endif %}
{% endif %}

{# ---------------- filesystem ---------------- #}
