{{ H.render_list(_fs_dev_ex, '      ') }}
{% endif %}
{% if _fs_dev_in is not none and ((_fs_dev_in is sequence and _fs_dev_in|length>0) or (_fs_dev_in is string and _fs_dev_in|trim|length>0)) %}
    includes:
{{ H.render_list(_fs_dev_in, '      ') }}
{% endif %}
{% endif %}

{% set _fs_fs_ex = S.get('filesystem.filesystems.excludes') %}
{% set _fs_fs_in = S.get('filesystem.filesystems.includes') %}
{% if (_fs_fs_ex is not none and ((_fs_fs_ex is sequence and _fs_fs_ex|length>0) or (_fs_fs_ex is string and _fs_fs_ex|trim|length>0)))
   or (_fs_fs_in is not none and ((_fs_fs_in is sequence and _fs_fs_in|length>0) or (_fs_fs_in is string and _fs_fs_in|trim|length>0))) %}
  filesystems:
{% if _fs_fs_ex is not none and ((_fs_fs_ex is sequence and _fs_fs_ex|length>0) or (_fs_fs_ex is string and _fs_fs_ex|trim|length>0)) %}
    excludes:
{{ H.render_list(_fs_fs_ex, '      ') }}
{% endif %}
{% if _fs_fs_in is not none and ((_fs_fs_in is sequence and _fs_fs_in|length>0) or (_fs_fs_in is string and _fs_fs_in|trim|length>0)) %}
    includes:
{{ H.render_list(_fs_fs_in, '      ') }}
{% endif %}
{% endif %}

  mountpoints:
    excludes:
      - "/sys/kernel/debug/tracing"
{% set _fs_mp_ex = S.get('filesystem.mountpoints.excludes') %}
{% if _fs_mp_ex is not none and ((_fs_mp_ex is sequence and _fs_mp_ex|length>0) or (_fs_mp_ex is string and _fs_mp_ex|trim|length>0)) %}
{{ H.render_list(_fs_mp_ex, '      ') }}
{% endif %}
{% set _fs_mp_in = S.get('filesystem.mountpoints.includes') %}
{% if _fs_mp_in is not none and ((_fs_mp_in is sequence and _fs_mp_in|length>0) or (_fs_mp_in is string and _fs_mp_in|trim|length>0)) %}
    includes:
{{ H.render_list(_fs_mp_in, '      ') }}
{% endif %}

{# ---------------- network ---------------- #}
{% set _nw_ex = S.get('network.devices.excludes') %}
{% set _nw_in = S.get('network.devices.includes') %}
{% if (_nw_ex is not none and ((_nw_ex is sequence and _nw_ex|length>0) or (_nw_ex is string and _nw_ex|trim|length>0)))
