#jinja2: trim_blocks: True, lstrip_blocks: False
{% set S = destination.settings | default({}, true) %}
{% import 'common/macros.j2' as H with context %}

{% set m         = (multiplex_value | default(1, true) | int) %}
{% set idx       = (i | default(1, true) | int) %}
{% set dest_name = destination.name | default('dest', true) %}

# clickhouse
type: clickhouse
endpoint: "{{ H.get('endpoint', '') }}"
table: "{{ H.get('table', '') }}"

{% set _db = S.get('database') %}
{% if _db is not none and (_db|string)|trim|length > 0 %}
database: "{{ H.get('database', '') }}"
{% endif %}

format: {{ H.get('format', 'json_each_row') }}

{# ---------- acknowledgements ---------- #}
{% if S.get('acknowledgements.enabled') is not none %}
acknowledgements:
  enabled: {{ H.getbool('acknowledgements.enabled', false) }}
{% endif %}

{# ---------- auth (aws | basic | bearer | custom) ---------- #}
{% set _auth_strategy = H.get('auth.strategy', 'basic') %}
{% if _auth_strategy is not none and (_auth_strategy|string)|trim|length > 0 %}
auth:
  strategy: {{ _auth_strategy }}
{% if _auth_strategy == 'basic' %}
  user: "{{ H.get('auth.user', '') }}"
  password: "{{ H.get('auth.password', '') }}"
{% elif _auth_strategy == 'bearer' %}
  token: "{{ H.get('auth.token', '') }}"
{% elif _auth_strategy == 'custom' %}
  value: "{{ H.get('auth.value', '') }}"
{% elif _auth_strategy == 'aws' %}
{% set _assume_role = S.get('auth.assume_role') %}
{% if _assume_role is not none and (_assume_role|string)|trim|length > 0 %}
  assume_role: "{{ H.get('auth.assume_role', '') }}"
{% endif %}
{% set _service = S.get('auth.service') %}
{% if _service is not none and (_service|string)|trim|length > 0 %}
  service: "{{ H.get('auth.service', '') }}"
{% endif %}
  auth:
    access_key_id: "{{ H.get('auth.auth.access_key_id', '') }}"
    secret_access_key: "{{ H.get('auth.auth.secret_access_key', '') }}"
{% set _ext_id = S.get('auth.auth.external.id') %}
{% if _ext_id is not none and (_ext_id|string)|trim|length > 0 %}
    external_id: "{{ H.get('auth.auth.external.id', '') }}"
{% endif %}
{% set _region = S.get('auth.auth.region') %}
{% if _region is not none and (_region|string)|trim|length > 0 %}
    region: "{{ H.get('auth.auth.region', '') }}"
{% endif %}
{% set _sess_name = S.get('auth.auth.session_name') %}
{% if _sess_name is not none and (_sess_name|string)|trim|length > 0 %}
    session_name: "{{ H.get('auth.auth.session_name', '') }}"
{% endif %}
{% set _sess_token = S.get('auth.auth.session_token') %}
{% if _sess_token is not none and (_sess_token|string)|trim|length > 0 %}
    session_token: "{{ H.get('auth.auth.session_token', '') }}"
{% endif %}
{% if S.get('auth.auth.imds.connect_timeout_seconds') is not none or S.get('auth.auth.imds.max_attempts') is not none %}
    imds:
      connect_timeout_seconds: {{ H.getint('auth.auth.imds.connect_timeout_seconds', 1) }}
      max_attempts: {{ H.getint('auth.auth.imds.max_attempts', 4) }}
{% endif %}
{% endif %}
{% endif %}

batch:
{% if S.get('batch.max_bytes') is not none %}
  max_bytes: {{ H.getint('batch.max_bytes', 10000000) }}
{% endif %}
  max_events: {{ H.getint('batch.max_events', 500) }}
  timeout_secs: {{ H.getint('batch.timeout_secs', 300) }}

buffer:
  type: {{ H.get('buffer.type', 'memory') }}
{% set _btype = S.get('buffer.type') %}
{% if _btype is none or _btype == 'memory' %}
  max_events: {{ H.getint('buffer.max_events', 500) }}
{% else %}
  max_size: {{ H.getint('buffer.max_size', 268435488) }}
{% endif %}
  when_full: {{ H.get('buffer.when_full', 'block') }}

compression: {{ H.get('compression', 'gzip') }}

{% if S.get('dangerously_allow_unconfined_template_resolution') is not none %}
dangerously_allow_unconfined_template_resolution: {{ H.getbool('dangerously_allow_unconfined_template_resolution', false) }}
{% endif %}

{% if S.get('date_time_best_effort') is not none %}
date_time_best_effort: {{ H.getbool('date_time_best_effort', false) }}
{% endif %}

{# ---------- encoding ---------- #}
encoding:
{% set except_fields = S.get('encoding.except_fields') %}
{% if (except_fields is string and except_fields|trim|length > 0) or (except_fields is sequence and not (except_fields is string) and except_fields|length > 0) %}
  except_fields:
{{ H.render_list(except_fields, '    ') }}
{% endif %}
{% set only_fields = S.get('encoding.only_fields') %}
{% if (only_fields is string and only_fields|trim|length > 0) or (only_fields is sequence and not (only_fields is string) and only_fields|length > 0) %}
  only_fields:
{{ H.render_list(only_fields, '    ') }}
{% endif %}
  timestamp_format: {{ H.get('encoding.timestamp', 'rfc3339') }}

{% if S.get('insert_random_shard') is not none %}
insert_random_shard: {{ H.getbool('insert_random_shard', false) }}
{% endif %}

{% if S.get('skip_unknown_fields') is not none %}
skip_unknown_fields: {{ H.getbool('skip_unknown_fields', false) }}
{% endif %}

request:
  concurrency: adaptive
  retry_max_duration_secs: 600 # 10 minutes

healthcheck:
  enabled: false

inputs:
{% if m == 1 %}
{% if destination.routes is defined and destination.routes | length > 0 %}
- 08_router.{{ H.sanitize(dest_name) }}
{% endif %}
{% if destination.fallback is truthy(convert_bool=True) %}
- 08_router._unmatched
{% endif %}
{% elif idx < m %}
- 08_mplex_{{ H.sanitize(dest_name) }}.r{{ idx }}
{% else %}
- 08_mplex_{{ H.sanitize(dest_name) }}._unmatched
{% endif %}

proxy:
  enabled: {{ H.getbool('proxy.enabled', false) }}
{% set _px_http = S.get('proxy.http') %}
{% if _px_http is not none and (_px_http|string)|trim|length > 0 %}
  http: "{{ H.get('proxy.http', '') }}"
{% endif %}
{% set _px_https = S.get('proxy.https') %}
{% if _px_https is not none and (_px_https|string)|trim|length > 0 %}
  https: "{{ H.get('proxy.https', '') }}"
{% endif %}
{% set np = S.get('proxy.no_proxy') %}
{% if (np is string and np|trim|length > 0) or (np is sequence and not (np is string) and np|length > 0) %}
  no_proxy:
{{ H.render_list(np, '    ') }}
{% endif %}

{# ---------- TLS (reuse common block) ---------- #}
{% set MODE = MODE | default('tcp') %}
{% include 'common/blocks/tls.j2' %}