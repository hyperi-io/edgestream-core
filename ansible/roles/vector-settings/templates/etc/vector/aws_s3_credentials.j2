{# ---------- helpers ---------- #}
{% set dests = destinations | default([]) %}
{% macro clean_name(n) -%}
{{ (n | default('unnamed', true))
    | replace('[','_')
    | replace(']','_')
    | replace(':','_')
    | replace('/','_')
    | replace('\\','_')
    | replace(' ', '_') }}
{%- endmacro %}

{# ---------- render AWS credentials profiles from aws_s3 destinations ---------- #}
{% for destination in dests %}
{% set dtype = (destination.type | default('', true)) %}
{% if dtype is match('aws_s3', ignorecase=True) %}
{% set settings = destination.settings | default({}) %}
{% set access_key    = settings.get('auth.access_key_id', '')     | default('', true) | string | trim %}
{% set secret_key    = settings.get('auth.secret_access_key', '') | default('', true) | string | trim %}
{% set session_token = settings.get('auth.session_token', '')     | default('', true) | string | trim %}

{% if (access_key | length) > 0 and (secret_key | length) > 0 %}
[{{ clean_name(destination.name) }}]
aws_access_key_id = {{ access_key }}
aws_secret_access_key = {{ secret_key }}
{% if (session_token | length) > 0 -%}
aws_session_token = {{ session_token }}
{%- endif %}
{% endif %}
{% endif %}
{% endfor %}
