{# Make S safe in all contexts #}
{% set _S = S if S is defined and S is mapping else {} %}

{% set tls_enabled = (_S.get('tls.enabled') | default(false, true) | bool) %}
{% set _mode = MODE | default('tcp') | lower %}
{% set _include_alpn = include_alpn | default(true, true) %}

{% if _mode == 'tcp' and tls_enabled %}
tls:
  enabled: {{ tls_enabled | lower }}

{# ----- ALPN (optional) ----- #}
{% if _include_alpn %}
{% set _alpn = _S.get('tls.alpn_protocols') %}
{% if (_alpn is string and _alpn|trim|length > 0) or (_alpn is sequence and not (_alpn is string) and (_alpn|length) > 0) %}
  alpn_protocols:
{{ H.render_list(_alpn, '    ') }}
{% endif %}
{% endif %}

{# ----- CA/Client certs/keys ----- #}
{% if _S.get('tls.ca_file') %}
  ca_file: {{ certificatePath }}/ca/{{ _S.get('tls.ca_file') | default('', true) }}
{% endif %}
{% if _S.get('tls.client_metadata_key') %}
  client_metadata_key: {{ _S.get('tls.client_metadata_key') }}
{% endif %}
{% if _S.get('tls.crt_file') %}
  crt_file: {{ certificatePath }}/certs/{{ _S.get('tls.crt_file') | default('', true) }}
{% endif %}
{% if _S.get('tls.key_file') %}
  key_file: {{ certificatePath }}/private/{{ _S.get('tls.key_file') | default('', true) }}
{% endif %}

{# ----- Key pass / SNI ----- #}
{% set _kp = _S.get('tls.key_pass') %}
{% if _kp is not none and (_kp|string)|trim|length > 0 %}
  key_pass: {{ _kp }}
{% endif %}
{% set _sni = _S.get('tls.server_name') %}
{% if _sni is not none and (_sni|string)|trim|length > 0 %}
  server_name: {{ _sni }}
{% endif %}

{# ----- Verification toggles ----- #}
{% if _S.get('tls.verify_certificate') is not none %}
  verify_certificate: {{ (_S.get('tls.verify_certificate') | bool) | lower }}
{% endif %}
{% if _S.get('tls.verify_hostname') is not none %}
  verify_hostname: {{ (_S.get('tls.verify_hostname') | bool) | lower }}
{% endif %}
{% endif %}
